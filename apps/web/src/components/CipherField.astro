---
/**
 * Decorative field of pale ciphertext that slowly drifts upwards.
 * Generated at build time with a seeded PRNG so builds are reproducible. aria-hidden.
 */
interface Props {
  rows?: number;
  seed?: number;
  class?: string;
}
const { rows = 14, seed = 7, class: className = '' } = Astro.props;

let state = seed;
const rand = (): number => {
  state = (state * 1664525 + 1013904223) % 4294967296;
  return state / 4294967296;
};
const alphabet = 'abcdefghijklmnopqrstuvwxyz0123456789';
const word = (n: number): string =>
  Array.from({ length: n }, () => alphabet.charAt(Math.floor(rand() * alphabet.length))).join('');
const line = (): string =>
  Array.from({ length: 16 }, () => word(4 + Math.floor(rand() * 9))).join('   ');
const lines = Array.from({ length: rows }, line);
---

<div
  class:list={[
    'cipher-field pointer-events-none absolute inset-0 hidden overflow-hidden md:block',
    className,
  ]}
  aria-hidden="true"
>
  <div class="cipher-scroll">{[0, 1].map(() => <pre>{lines.join('\n')}</pre>)}</div>
</div>

<style>
  /* Only the side gutters: never behind the headline, text or buttons. */
  .cipher-field {
    mask-image:
      linear-gradient(
        90deg,
        #000 0%,
        #000 12%,
        transparent 30%,
        transparent 70%,
        #000 88%,
        #000 100%
      ),
      linear-gradient(180deg, #000 0%, #000 55%, transparent 100%);
    mask-composite: intersect;
  }
  .cipher-scroll {
    position: absolute;
    left: 50%;
    top: 0;
    translate: -50% 0;
  }
  pre {
    margin: 0;
    font: 400 13px/2.1 var(--font-mono);
    letter-spacing: 0.04em;
    color: rgb(37 99 235 / 0.13);
    white-space: pre;
  }
  @media (prefers-reduced-motion: no-preference) {
    .cipher-scroll {
      animation: drift 60s linear infinite;
    }
  }
  @keyframes drift {
    to {
      transform: translateY(-50%);
    }
  }
</style>
