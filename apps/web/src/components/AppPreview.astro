---
import Icon, { type IconName } from './Icon.astro';

const accounts = [
  { name: 'Google Drive · Personal', used: '10.8 GB of 15 GB', w: 'w-[72%]' },
  { name: 'OneDrive · Work', used: '240 GB of 1 TB', w: 'w-[24%]' },
  { name: 'Dropbox · Family', used: '0.9 GB of 2 GB', w: 'w-[45%]' },
];
const folders = [
  ['Documents', 'Google Drive'],
  ['Work projects', 'OneDrive'],
  ['Family photos', 'Dropbox'],
];
const features: { icon: IconName; title: string; body: string }[] = [
  {
    icon: 'zap',
    title: 'Works in the background',
    body: 'Save a file as usual. Syncvault notices and syncs it for you.',
  },
  {
    icon: 'users',
    title: 'Many accounts, no juggling',
    body: 'Personal, work and family clouds side by side in one app.',
  },
  {
    icon: 'shield',
    title: 'Never lose a file',
    body: 'Deleted or replaced files are kept safe first, just in case.',
  },
  {
    icon: 'languages',
    title: 'In your language',
    body: 'Translated by volunteers — Sinhala and Tamil are on the way.',
  },
];
---

<section class="bg-page px-5 py-24" data-reveal>
  <div class="mx-auto max-w-5xl">
    <p class="eyebrow reveal text-center">The app</p>
    <h2 class="display reveal mt-3 text-center text-4xl sm:text-5xl [--i:1]">
      Every cloud. One calm screen.
    </h2>
    <p class="reveal mx-auto mt-4 max-w-md text-center leading-relaxed text-text-muted [--i:2]">
      See all your accounts and folders at a glance. A lock means protected. A tick means safely
      synced. That's it.
    </p>

    <!-- Illustration of the app (decorative; the text above describes it). -->
    <div
      class="window reveal reveal-scale mt-14 overflow-hidden rounded-2xl border border-border bg-white shadow-[0_40px_80px_-40px_rgb(17_24_39/0.35)] [--i:3]"
      aria-hidden="true"
    >
      <div class="flex gap-1.5 border-b border-border px-4 py-3">
        <span class="size-2.5 rounded-full bg-border"></span>
        <span class="size-2.5 rounded-full bg-border"></span>
        <span class="size-2.5 rounded-full bg-border"></span>
      </div>
      <div class="flex">
        <div class="hidden w-48 shrink-0 bg-ink p-4 text-sm text-white/70 sm:block">
          <p class="mb-4 flex items-center gap-2 font-semibold text-white">
            <span class="size-4 rounded bg-primary"></span>Syncvault
          </p>
          <p class="rounded-lg bg-ink-raised px-3 py-2 text-white">Overview</p>
          <p class="px-3 py-2">Folders</p>
          <p class="px-3 py-2">Clouds</p>
          <p class="px-3 py-2">Activity</p>
        </div>
        <div class="min-w-0 flex-1 space-y-3 p-4 sm:p-5">
          <div class="flex items-center gap-3 rounded-xl border border-border px-4 py-3">
            <Icon name="check" class="tick size-5 text-primary" />
            <div>
              <p class="text-sm font-semibold">Everything is safe and up to date</p>
              <p class="text-xs text-text-muted">3 clouds · 4 folders · last synced just now</p>
            </div>
          </div>
          <div class="grid gap-3 sm:grid-cols-3">
            {accounts.map((a, i) => (
              <div class="rounded-xl border border-border p-4">
                <p class="truncate text-sm font-semibold">{a.name}</p>
                <div class="mt-3 h-1.5 overflow-hidden rounded-full bg-primary-light">
                  <div class:list={['bar h-full rounded-full bg-primary', a.w, `[--i:${i}]`]} />
                </div>
                <p class="mt-2 text-xs text-text-muted">{a.used}</p>
              </div>
            ))}
          </div>
          <div class="divide-y divide-border rounded-xl border border-border text-sm">
            {folders.map(([name, cloud], i) => (
              <div class="grid grid-cols-[1fr_auto] items-center gap-3 px-4 py-2.5 sm:grid-cols-[1.2fr_1fr_auto]">
                <span class="font-semibold">{name}</span>
                <span class="hidden text-text-muted sm:inline">{cloud}</span>
                <span
                  class:list={[
                    'badge inline-flex items-center gap-1 rounded-md bg-primary-light px-2 py-0.5 text-xs font-medium text-primary-text',
                    `[--i:${i}]`,
                  ]}
                >
                  <Icon name="lock" class="size-3" /> Locked
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {features.map((f, i) => (
        <li class:list={['card reveal p-6', `[--i:${i + 4}]`]}>
          <span class="grid size-9 place-items-center rounded-full bg-ink text-white">
            <Icon name={f.icon} class="size-4" />
          </span>
          <h3 class="mt-5 font-semibold">{f.title}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-text-muted">{f.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .bar {
    transform-origin: left;
  }
  @media (prefers-reduced-motion: no-preference) and (scripting: enabled) {
    .bar {
      transition: transform 1.1s var(--ease-out-soft);
      transition-delay: calc(0.7s + var(--i, 0) * 0.15s);
    }
    .badge,
    .tick {
      transition:
        transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1),
        opacity 0.3s;
      transition-delay: calc(1.2s + var(--i, 0) * 0.18s);
    }
    section:not(:global(.is-visible)) .bar {
      transform: scaleX(0);
    }
    section:not(:global(.is-visible)) .badge,
    section:not(:global(.is-visible)) .tick {
      transform: scale(0.4);
      opacity: 0;
    }
  }
</style>
