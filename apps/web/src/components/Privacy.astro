---
import Icon, { type IconName } from './Icon.astro';
import SectionHeader from './SectionHeader.astro';

const rows: { icon: IconName; plain: string; cipher: string; size: string }[] = [
  { icon: 'file', plain: 'passport-scan.pdf', cipher: 'k3v9q0x7m2a1…', size: '2.4 MB' },
  { icon: 'image', plain: 'Family photos/', cipher: 'p8d1z1r4t9w/', size: '—' },
  { icon: 'file', plain: 'house-contract.docx', cipher: 'w2n6hy0c5e8r…', size: '310 KB' },
  { icon: 'file', plain: 'medical-report.pdf', cipher: 'f7j3ub8sq1lz…', size: '1.1 MB' },
  { icon: 'file', plain: 'tax-return-2026.xlsx', cipher: 'm0x4ta9kv2pe…', size: '86 KB' },
];
const checks = ['No ads', 'No tracking', 'No account with us', 'Code anyone can check'];
---

<section id="privacy" class="px-5 py-28" data-reveal>
  <div class="mx-auto grid max-w-5xl items-center gap-14 md:grid-cols-[1.25fr_1fr]">
    <div>
      <SectionHeader index="02" label="Your privacy" size="md">
        Your cloud keeps your files. <br class="hidden lg:block" />
        It just can't read them.
      </SectionHeader>
      <p class="reveal mt-5 leading-relaxed text-text-muted [--i:2]">
        Before anything leaves your computer, Syncvault scrambles it — even the file names. Google,
        Microsoft, Dropbox and the people who make Syncvault only ever see nonsense.
      </p>
      <ul class="mt-7 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-border bg-border text-sm font-medium">
        {checks.map((c, i) => (
          <li class:list={['reveal flex items-center gap-2 bg-white px-4 py-3', `[--i:${i + 3}]`]}>
            <Icon name="check" class="size-4 shrink-0 text-primary" /> {c}
          </li>
        ))}
      </ul>
    </div>

    <div class="reveal reveal-scale [--i:2]">
      <!-- What the cloud stores; your pointer (the key) reveals the real names. -->
      <div
        class="lens overflow-hidden rounded-2xl bg-ink text-white shadow-[0_30px_60px_-25px_rgb(10_10_11/0.6)]"
        data-lens
      >
        <div class="flex items-center gap-3 border-b border-white/10 px-4 py-3">
          <span class="flex gap-1.5" aria-hidden="true">
            <span class="size-2.5 rounded-full bg-white/15"></span>
            <span class="size-2.5 rounded-full bg-white/15"></span>
            <span class="size-2.5 rounded-full bg-white/15"></span>
          </span>
          <span class="truncate font-mono text-[11px] text-white/55">
            drive.google.com › My Drive
          </span>
          <button
            type="button"
            class="key-btn ml-auto inline-flex shrink-0 whitespace-nowrap min-h-touch items-center gap-1.5 rounded-full border border-white/15 px-3 text-xs font-medium text-white transition hover:bg-white/10"
            data-lens-toggle
            aria-pressed="false"
          >
            <Icon name="key" class="size-3.5" />
            <span class="label-locked">Use your key</span>
            <span class="label-unlocked">Lock again</span>
          </button>
        </div>

        <div class="area relative" data-lens-area aria-hidden="true">
          <ul class="layer">
            {rows.map((r) => (
              <li class="row">
                <Icon name={r.icon} class="size-4 shrink-0 text-white/35" />
                <span class="flex-1 truncate text-white/60" data-cipher={r.cipher}>
                  {r.cipher}
                </span>
                <span class="text-white/35">{r.size}</span>
              </li>
            ))}
          </ul>
          <ul class="layer plain absolute inset-0">
            {rows.map((r) => (
              <li class="row bg-ink">
                <Icon name={r.icon} class="size-4 shrink-0 text-primary-bright" />
                <span class="flex-1 truncate text-white">{r.plain}</span>
                <span class="text-white/35">{r.size}</span>
              </li>
            ))}
          </ul>
          <span class="ring pointer-events-none absolute"></span>
        </div>
      </div>
      <p class="mt-3 font-mono text-xs text-text-muted">
        <span class="hint-pointer">// point at a file — your key reveals it.</span>
        <span class="hint-touch">// tap “Use your key” to read them.</span>
      </p>

      <table class="sr-only">
        <caption>File names on your computer and what the cloud stores</caption>
        <thead>
          <tr>
            <th scope="col">What you see</th>
            <th scope="col">What the cloud sees</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td>{r.plain}</td>
              <td>{r.cipher}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  @property --lr {
    syntax: '<length>';
    inherits: true;
    initial-value: 0px;
  }
  .row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.8rem 1.1rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.06);
    font: 400 13px/1.3 var(--font-mono);
    white-space: nowrap;
  }
  .row:last-child {
    border-bottom: 0;
  }
  .area {
    --lx: 50%;
    --ly: 50%;
    --lr: 0px;
    cursor: crosshair;
  }
  .plain {
    mask-image: radial-gradient(
      circle var(--lr) at var(--lx) var(--ly),
      #000 72%,
      transparent 100%
    );
    transition: --lr 0.35s var(--ease-out-soft);
  }
  .ring {
    left: var(--lx);
    top: var(--ly);
    width: calc(var(--lr) * 2);
    height: calc(var(--lr) * 2);
    translate: -50% -50%;
    border: 1px solid rgb(96 165 250 / 0.55);
    border-radius: 999px;
    box-shadow: 0 0 40px rgb(96 165 250 / 0.25);
    opacity: 0;
    transition:
      opacity 0.3s,
      width 0.35s var(--ease-out-soft),
      height 0.35s var(--ease-out-soft);
  }
  .lens:global(.is-peeking) .area {
    --lr: 78px;
  }
  .lens:global(.is-peeking):not(:global(.is-unlocked)) .ring {
    opacity: 1;
  }
  .lens:global(.is-unlocked) .area {
    --lr: 1400px;
  }
  .key-btn[aria-pressed='true'] {
    background: var(--color-primary);
    border-color: var(--color-primary);
  }
  .label-unlocked,
  .key-btn[aria-pressed='true'] .label-locked {
    display: none;
  }
  .key-btn[aria-pressed='true'] .label-unlocked {
    display: inline;
  }
  .hint-touch {
    display: none;
  }
  @media not ((hover: hover) and (pointer: fine)) {
    .hint-pointer {
      display: none;
    }
    .hint-touch {
      display: inline;
    }
  }
  /* Without JS the lens can't work: hide the button and its hints. */
  :global(html:not(.js)) .key-btn,
  :global(html:not(.js)) .hint-pointer,
  :global(html:not(.js)) .hint-touch {
    display: none;
  }
</style>
