---
import Icon, { type IconName } from './Icon.astro';

/*
 * "How Syncvault connects everything".
 * Desktop: a fixed-ratio stage (viewBox 1000×360). Cards are placed in % of the stage and one SVG
 * draws thin 1px curves between them, so lines always meet the cards at any width.
 * Grey dots = readable files travelling into Syncvault; blue dots = locked data leaving it.
 * Mobile: the same story stacked vertically.
 */
interface Node {
  id: string;
  icon: IconName;
  title: string;
  note: string;
  /** Tailwind class placing the card's vertical centre on the stage (y / 360). */
  top: string;
}

const files: Node[] = [
  { id: 'l1', icon: 'file', title: 'Documents', note: 'On your laptop', top: 'top-[36.11%]' },
  { id: 'l2', icon: 'image', title: 'Family photos', note: 'On your laptop', top: 'top-[57.22%]' },
  {
    id: 'l3',
    icon: 'briefcase',
    title: 'Work projects',
    note: 'On your laptop',
    top: 'top-[78.33%]',
  },
];

const stores: Node[] = [
  {
    id: 'r1',
    icon: 'cloud',
    title: 'Google Drive',
    note: 'Sees only scrambled data',
    top: 'top-[25.56%]',
  },
  {
    id: 'r2',
    icon: 'cloud',
    title: 'OneDrive',
    note: 'Sees only scrambled data',
    top: 'top-[46.67%]',
  },
  {
    id: 'r3',
    icon: 'cloud',
    title: 'Dropbox',
    note: 'Sees only scrambled data',
    top: 'top-[67.78%]',
  },
  {
    id: 'r4',
    icon: 'drive',
    title: 'Portable drive',
    note: 'Locked, even if lost',
    top: 'top-[88.89%]',
  },
];

// Curves: card edge → vault edge (x 320 → 400) and vault edge → card edge (x 600 → 680).
const paths: Record<string, string> = {
  l1: 'M320 130 C360 130 360 186 400 186',
  l2: 'M320 206 C360 206 360 206 400 206',
  l3: 'M320 282 C360 282 360 226 400 226',
  r1: 'M600 176 C640 176 640 92 680 92',
  r2: 'M600 196 C640 196 640 168 680 168',
  r3: 'M600 216 C640 216 640 244 680 244',
  r4: 'M600 236 C640 236 640 320 680 320',
};

const outgoing = ['r1', 'r2', 'r3', 'r4'];
---

<div class="connect card relative overflow-hidden bg-page/60 p-6 sm:p-10" data-reveal>
  <h2 class="mb-8 text-center text-[15px] font-semibold text-text">
    How Syncvault connects everything
  </h2>
  <p class="sr-only">
    Your documents, photos and projects stay on your laptop. Syncvault locks them on your computer
    first, then Google Drive, OneDrive, Dropbox or a portable drive only ever store scrambled data.
  </p>

  <!-- Desktop stage -->
  <div
    class="stage relative mx-auto hidden aspect-[1000/360] max-w-4xl lg:block"
    aria-hidden="true"
  >
    <svg class="absolute inset-0 size-full overflow-visible" viewBox="0 0 1000 360" fill="none">
      {Object.entries(paths).map(([id, d]) => (
        <path
          id={`cx-${id}`}
          class:list={['line', `line-${id}`, id.startsWith('l') ? 'line-in' : 'line-out']}
          d={d}
          pathLength="1"
        />
      ))}
      {Object.entries(paths).map(([id, d]) => {
        const [start, end] = [d.slice(1).split(' ').slice(0, 2), d.split(' ').slice(-2)];
        return (
          <g class:list={['joint', id.startsWith('l') ? 'line-in' : 'line-out']}>
            <circle cx={start[0]} cy={start[1]} r="3" />
            <circle cx={end[0]} cy={end[1]} r="3" />
          </g>
        );
      })}
      <g class="flow">
        {['l1', 'l2', 'l3'].map((id, i) => (
          <circle r="3.5" class="dot-plain" opacity="0">
            <animateMotion
              dur="2.4s"
              begin={`${i * 0.8}s`}
              repeatCount="indefinite"
              calcMode="spline"
              keyTimes="0;1"
              keySplines="0.4 0 0.6 1"
            >
              <mpath href={`#cx-${id}`} />
            </animateMotion>
            <animate
              attributeName="opacity"
              values="0;1;1;0"
              keyTimes="0;0.15;0.8;1"
              dur="2.4s"
              begin={`${i * 0.8}s`}
              repeatCount="indefinite"
            />
          </circle>
        ))}
        {outgoing.map((id, i) => (
          <circle r="3.5" class="dot-locked" opacity="0">
            <animateMotion
              dur="2.4s"
              begin={`${1.2 + i * 0.6}s`}
              repeatCount="indefinite"
              calcMode="spline"
              keyTimes="0;1"
              keySplines="0.4 0 0.6 1"
            >
              <mpath href={`#cx-${id}`} />
            </animateMotion>
            <animate
              attributeName="opacity"
              values="0;1;1;0"
              keyTimes="0;0.15;0.8;1"
              dur="2.4s"
              begin={`${1.2 + i * 0.6}s`}
              repeatCount="indefinite"
            />
          </circle>
        ))}
      </g>
    </svg>

    <p class="label absolute left-0 top-[23.33%] -translate-y-1/2">Your files</p>
    <p class="label absolute left-[68%] top-[12.22%] -translate-y-1/2">Where they're stored</p>

    {files.map((n, i) => (
      <div class:list={['absolute left-0 w-[32%] -translate-y-1/2', n.top]}>
        <div class:list={['node reveal', `[--i:${i + 1}]`]} data-node={n.id}>
          <Icon name={n.icon} class="size-4 shrink-0 text-text-muted" />
          <span>
            <span class="node-title">{n.title}</span>
            <span class="node-note">{n.note}</span>
          </span>
        </div>
      </div>
    ))}

    <div class="absolute left-[40%] top-[57.22%] h-[38.89%] w-[20%] -translate-y-1/2">
      <div class="vault reveal reveal-scale h-full [--i:3]">
        <svg
          class="size-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="5" y="11" width="14" height="10" rx="2" />
          <path class="vault-shackle" d="M8 11V7a4 4 0 0 1 8 0v4" />
        </svg>
        <span class="mt-2 text-[15px] font-semibold">Syncvault</span>
        <span class="mt-1 text-xs leading-snug text-white/70">
          Locks your files
          <br />
          on your computer
        </span>
      </div>
    </div>

    {stores.map((n, i) => (
      <div class:list={['absolute left-[68%] w-[32%] -translate-y-1/2', n.top]}>
        <div class:list={['node reveal', `[--i:${i + 4}]`]} data-node={n.id}>
          <Icon name={n.icon} class="size-4 shrink-0 text-primary" />
          <span>
            <span class="node-title">{n.title}</span>
            <span class="node-note">{n.note}</span>
          </span>
        </div>
      </div>
    ))}
  </div>

  <!-- Mobile / tablet: vertical flow -->
  <div class="mx-auto max-w-md lg:hidden" aria-hidden="true">
    <p class="label mb-2">Your files</p>
    <div class="grid gap-2">
      {files.map((n, i) => (
        <div class:list={['node reveal', `[--i:${i}]`]}>
          <Icon name={n.icon} class="size-4 shrink-0 text-text-muted" />
          <span>
            <span class="node-title">{n.title}</span>
            <span class="node-note">{n.note}</span>
          </span>
        </div>
      ))}
    </div>
    <svg class="mx-auto my-1 h-14 w-6 overflow-visible" viewBox="0 0 24 56" fill="none">
      <path id="cx-m1" class="line line-in" d="M12 0 V56" pathLength="1" />
      <g class="flow">
        <circle r="3.5" class="dot-plain" opacity="0">
          <animateMotion dur="1.6s" repeatCount="indefinite">
            <mpath href="#cx-m1" />
          </animateMotion>
          <animate
            attributeName="opacity"
            values="0;1;1;0"
            keyTimes="0;0.15;0.8;1"
            dur="1.6s"
            repeatCount="indefinite"
          />
        </circle>
      </g>
    </svg>
    <div class="vault reveal reveal-scale mx-auto w-56 py-6 [--i:3]">
      <svg
        class="size-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="5" y="11" width="14" height="10" rx="2" />
        <path class="vault-shackle" d="M8 11V7a4 4 0 0 1 8 0v4" />
      </svg>
      <span class="mt-2 text-[15px] font-semibold">Syncvault</span>
      <span class="mt-1 text-xs text-white/70">Locks your files on your computer</span>
    </div>
    <svg class="mx-auto my-1 h-14 w-6 overflow-visible" viewBox="0 0 24 56" fill="none">
      <path id="cx-m2" class="line line-out" d="M12 0 V56" pathLength="1" />
      <g class="flow">
        <circle r="3.5" class="dot-locked" opacity="0">
          <animateMotion dur="1.6s" begin="0.8s" repeatCount="indefinite">
            <mpath href="#cx-m2" />
          </animateMotion>
          <animate
            attributeName="opacity"
            values="0;1;1;0"
            keyTimes="0;0.15;0.8;1"
            dur="1.6s"
            begin="0.8s"
            repeatCount="indefinite"
          />
        </circle>
      </g>
    </svg>
    <p class="label mb-2">Where they're stored</p>
    <div class="grid gap-2 sm:grid-cols-2">
      {stores.map((n, i) => (
        <div class:list={['node reveal', `[--i:${i + 4}]`]}>
          <Icon name={n.icon} class="size-4 shrink-0 text-primary" />
          <span>
            <span class="node-title">{n.title}</span>
            <span class="node-note">{n.note}</span>
          </span>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .node {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.875rem;
    background: #fff;
    transition:
      border-color 0.2s,
      box-shadow 0.2s,
      opacity 0.7s var(--ease-out-soft),
      transform 0.7s var(--ease-out-soft);
    transition-delay: 0s, 0s, calc(var(--i, 0) * 90ms), calc(var(--i, 0) * 90ms);
  }
  .node:hover {
    border-color: color-mix(in srgb, var(--color-primary) 45%, transparent);
    box-shadow: 0 6px 20px -10px rgb(37 99 235 / 0.35);
  }
  .node-title {
    display: block;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.25;
  }
  .node-note {
    display: block;
    font-size: 12px;
    color: var(--color-text-muted);
  }
  .vault {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 0.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 1.25rem;
    background: var(--color-ink);
    color: #fff;
    text-align: center;
    box-shadow: 0 24px 48px -20px rgb(10 10 11 / 0.55);
  }

  /* Thin lines */
  .line {
    stroke: #b9c0ca;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    transition: stroke 0.25s;
  }
  .line-out {
    stroke: color-mix(in srgb, var(--color-primary) 45%, #c9ced6);
  }
  .joint circle {
    fill: #fff;
    stroke: #c9ced6;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .dot-plain {
    fill: #9ca3af;
  }
  .dot-locked {
    fill: var(--color-primary);
  }

  /* Hover a card → highlight its line */
  .stage:has([data-node='l1']:hover) .line-l1,
  .stage:has([data-node='l2']:hover) .line-l2,
  .stage:has([data-node='l3']:hover) .line-l3,
  .stage:has([data-node='r1']:hover) .line-r1,
  .stage:has([data-node='r2']:hover) .line-r2,
  .stage:has([data-node='r3']:hover) .line-r3,
  .stage:has([data-node='r4']:hover) .line-r4 {
    stroke: var(--color-primary);
  }

  @media (prefers-reduced-motion: reduce) {
    .flow {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .flow {
      transition: opacity 0.6s 1.6s;
    }
    .vault-shackle {
      transition: transform 0.45s 1.1s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .vault::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      box-shadow: 0 0 0 0 rgb(37 99 235 / 0.45);
    }
    .connect.is-visible .vault::after {
      animation: ring 2.6s 1.5s ease-out infinite;
    }

    @media (scripting: enabled) {
      .line,
      .joint {
        transition:
          stroke-dashoffset 0.9s var(--ease-out-soft),
          opacity 0.4s,
          stroke 0.25s;
      }
      .line-in {
        transition-delay: 0.35s;
      }
      .line-out {
        transition-delay: 1.05s;
      }
      .connect:not(.is-visible) .line {
        stroke-dashoffset: 1;
      }
      .connect:not(.is-visible) .joint {
        opacity: 0;
      }
      .connect:not(.is-visible) .flow {
        opacity: 0;
      }
      .connect:not(.is-visible) .vault-shackle {
        transform: translateY(-3px);
      }
    }
  }

  @keyframes ring {
    0% {
      box-shadow: 0 0 0 0 rgb(37 99 235 / 0.4);
    }
    70%,
    100% {
      box-shadow: 0 0 0 14px rgb(37 99 235 / 0);
    }
  }
</style>
