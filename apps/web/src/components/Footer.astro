---
import Logo from './Logo.astro';
import { SITE } from '../site';

const links = [
  { href: '#how-it-works', label: 'How it works' },
  { href: '#privacy', label: 'Privacy' },
  { href: '#community', label: 'Community' },
  { href: SITE.links.source, label: 'Source code' },
  { href: SITE.links.sponsor, label: 'Support us' },
];
---

<footer class="border-t border-border px-5 py-12">
  <div class="mx-auto flex max-w-5xl flex-col justify-between gap-8 md:flex-row">
    <div class="max-w-xs">
      <Logo />
      <p class="mt-3 text-sm leading-relaxed text-text-muted">
        All your clouds in one place, locked with your key. Started in Sri Lanka, made with people
        around the world.
      </p>
    </div>
    <div class="md:text-right">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-text-muted md:justify-end">
        {links.map((l) => (
          <li>
            <a href={l.href} class="hover:text-text">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-4 text-xs text-text-muted">
        getsyncvault.com · We collect nothing about you. · GPL-3.0
      </p>
    </div>
  </div>
</footer>
