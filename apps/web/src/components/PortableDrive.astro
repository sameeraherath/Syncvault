---
const files = ['8fq2kz0w1m…', 'x4c9e7tb2n…', 'r1m8ya5pq3…'];
---

<section class="px-5 py-24" data-reveal>
  <div class="relative mx-auto grid max-w-5xl items-center gap-10 overflow-hidden rounded-[2rem] border border-primary/25 bg-[#0c1630] p-8 sm:p-12 md:grid-cols-[1fr_1.1fr]">
    <div class="dot-grid pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
    <div class="relative">
      <span class="reveal inline-flex items-center gap-1.5 rounded-full bg-card px-2.5 py-1 font-mono text-[11px] font-medium">
        <span class="size-1.5 animate-pulse rounded-full bg-primary"></span> coming soon
      </span>
      <h2 class="display reveal mt-4 text-3xl sm:text-[2.6rem] [--i:1]">
        Plug in your hard drive. It's locked too.
      </h2>
      <p class="reveal mt-4 leading-relaxed text-text-muted [--i:2]">
        Back up or move files to a portable drive with the same protection. Lose the drive? Nobody
        can open it.
      </p>
    </div>

    <div class="relative flex flex-col items-center" aria-hidden="true">
      <!-- USB drive -->
      <div class="drive relative">
        <svg class="h-28 w-64" viewBox="0 0 256 112" fill="none">
          <rect x="196" y="38" width="56" height="36" rx="5" fill="#cfd5dd" />
          <rect x="212" y="47" width="10" height="7" rx="1.5" fill="#9aa3af" />
          <rect x="230" y="47" width="10" height="7" rx="1.5" fill="#9aa3af" />
          <rect x="4" y="16" width="200" height="80" rx="18" fill="#0a0a0b" stroke="#2a3a63" />
          <rect x="22" y="36" width="96" height="6" rx="3" fill="#2a2a30" />
          <rect x="22" y="50" width="64" height="6" rx="3" fill="#2a2a30" />
          <text x="22" y="80" fill="#60a5fa" font-family="IBM Plex Mono, monospace" font-size="11">
            SYNCVAULT
          </text>
        </svg>
        <span class="lock absolute left-[58%] top-1 grid size-11 place-items-center rounded-full bg-primary text-white shadow-[0_8px_20px_-6px_rgb(37_99_235/0.7)]">
          <svg
            class="size-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="5" y="11" width="14" height="10" rx="2" />
            <path class="shackle" d="M8 11V7a4 4 0 0 1 8 0v4" />
          </svg>
        </span>
      </div>
      <ul class="files mt-6 w-full max-w-xs rounded-xl border border-white/10 bg-card/80 p-3 font-mono text-xs shadow-sm backdrop-blur">
        {files.map((f, i) => (
          <li class:list={['file flex justify-between gap-4 px-1 py-1', `[--k:${i}]`]}>
            <span class="text-text-muted">{f}</span>
            <span class="text-primary-bright">locked</span>
          </li>
        ))}
      </ul>
      <p class="mt-3 font-mono text-[11px] text-text-muted">
        // lose the drive? nobody can open it.
      </p>
    </div>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) and (scripting: enabled) {
    .drive {
      transition:
        transform 0.9s 0.3s var(--ease-out-soft),
        opacity 0.6s 0.3s;
    }
    .lock {
      transition: transform 0.45s 1.1s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .shackle {
      transition: transform 0.4s 1.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .file {
      transition:
        opacity 0.4s,
        transform 0.4s var(--ease-out-soft);
      transition-delay: calc(1.7s + var(--k) * 0.15s);
    }
    section:not(:global(.is-visible)) .drive {
      transform: translateX(80px);
      opacity: 0;
    }
    section:not(:global(.is-visible)) .lock {
      transform: scale(0);
    }
    section:not(:global(.is-visible)) .shackle {
      transform: translateY(-3px);
    }
    section:not(:global(.is-visible)) .file {
      opacity: 0;
      transform: translateY(6px);
    }
  }
</style>
