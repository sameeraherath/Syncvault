---
import Logo from './Logo.astro';
import { SITE } from '../site';

const links = [
  { href: '#how-it-works', label: 'How it works' },
  { href: '#privacy', label: 'Privacy' },
  { href: '#community', label: 'Community' },
  { href: '#questions', label: 'Questions' },
];
---

<header class="nav sticky top-0 z-50 border-b border-transparent" data-nav>
  <nav class="mx-auto flex h-16 max-w-5xl items-center justify-between px-5" aria-label="Main">
    <a href="#top" class="rounded-md" aria-label="Syncvault home">
      <Logo />
    </a>
    <ul class="hidden items-center gap-8 text-sm text-text-muted md:flex">
      {links.map((l) => (
        <li>
          <a href={l.href} class="transition-colors hover:text-text">
            {l.label}
          </a>
        </li>
      ))}
    </ul>
    <a href={SITE.links.download} class="btn bg-white text-ink hover:bg-white/85">
      Get Syncvault — free
    </a>
  </nav>
</header>

<style>
  .nav {
    transition:
      transform 0.35s var(--ease-out-soft),
      background-color 0.3s,
      border-color 0.3s,
      backdrop-filter 0.3s;
  }
  /* Slides away while scrolling down; keyboard focus always brings it back. */
  .nav:global(.is-hidden):not(:focus-within) {
    transform: translateY(-100%);
  }
  .nav:global(.is-scrolled) {
    background: rgb(10 10 11 / 0.78);
    backdrop-filter: saturate(180%) blur(14px);
    border-bottom-color: var(--color-border);
  }
</style>
