# dependencies
node_modules/

# build output
out/
dist/
.astro/
.vercel/
release/
*.tsbuildinfo
crates/**/target/
*.node

# rclone binaries are downloaded by `pnpm fetch:rclone`, never committed
resources/rclone/*
!resources/rclone/README.md

# secrets, local config, user data — never commit
.env
.env.*
*.conf
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sock
*.pem
*.key

# logs / OS / editor
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
coverage/
